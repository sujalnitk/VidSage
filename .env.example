# Server configuration. Copy to .env and fill in your real keys locally.
# .env is loaded automatically and is ignored by Git.
# Restart Streamlit after editing this file's local copy.

# Chat: provider/model (e.g. gemini/..., openai/..., anthropic/...)
LLM_MODEL=gemini/gemini-3.8-flash
LLM_API_KEY=
# Optional custom/OpenAI-compatible endpoint, including /v1 if required.
LLM_BASE_URL=

# Groq alternative: LLM_MODEL=groq/openai/gpt-oss-120b
# Set LLM_API_KEY to your Groq key, or use GROQ_API_KEY.
# Groq chat still needs a separately configured embedding provider/key.

# Embeddings may use a different provider. For matching providers/endpoints,
# leave EMBEDDING_API_KEY empty to reuse LLM_API_KEY.
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Alternatively, set native provider keys such as GOOGLE_API_KEY,
# GEMINI_API_KEY, OPENAI_API_KEY, or ANTHROPIC_API_KEY in this file.

# Invited pilot: require owner-verified prices before allowing paid work.
# See eval/rates.example.json; do not put keys in a rate card.
VIDSAGE_PILOT=0
VIDSAGE_RATE_CARD=
# Optional local SQLite path (keep it private and on persistent storage).
VIDSAGE_DB=.vidsage/pilot.sqlite3
